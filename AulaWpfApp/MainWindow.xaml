<Window x:Class="AulaWpfApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AULA 60 HE Control" Height="650" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lớp phủ tối để chữ dễ đọc trên nền ảnh -->
        <Rectangle Fill="#0B0F0D" Opacity="0.55" Grid.ColumnSpan="2"/>

        <!-- SIDEBAR -->
        <Border Background="{StaticResource BgPanel}" Grid.Column="0" BorderBrush="{StaticResource BorderMist}" BorderThickness="0,0,1,0">
            <StackPanel>

                <TextBlock Text="AULA 60 HE" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource TitleFont}" FontSize="22" FontWeight="Bold" Margin="20,25,20,25"/>

                <Button Content="Keyboard" Style="{StaticResource SidebarButton}"/>
                <Button Content="Rapid Trigger" Style="{StaticResource SidebarButton}"/>
                <Button Content="SOCD" Style="{StaticResource SidebarButton}"/>
                <Button Content="RGB" Style="{StaticResource SidebarButton}"/>
                <Button Content="Profiles" Style="{StaticResource SidebarButton}"/>

            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="40">

            <StackPanel>

                <TextBlock Text="AULA 60 HE" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>

                <TextBlock x:Name="ConnectionStatusText" Text="DISCONNECTED" Foreground="{StaticResource StatusBad}" FontSize="15" Margin="0,10,0,0"/>

                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderMist}" BorderThickness="1" Padding="25" Margin="0,25,0,20" CornerRadius="6">

                    <StackPanel>

                        <TextBlock Text="Keyboard Status" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource TitleFont}" FontSize="18"/>

                        <TextBlock Text="Device: AULA 60 HE" Foreground="{StaticResource TextSecondary}" Margin="0,15,0,5"/>

                        <TextBlock x:Name="DevicePathText" Text="Firmware: Chưa kết nối" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <Button Content="SCAN KEYBOARD" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Click="ScanKeyboard_Click"/>

                <Button Content="TEST RGB" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestRgb_Click"/>

                <Button Content="TEST CUSTOM COLOR" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestCustomColor_Click"/>

                <Button Content="TEST AUDIO" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestAudio_Click"/>

                <TextBlock x:Name="AudioLevelText" Text="Audio Level: 0.00" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,18,0,0"/>

                <ProgressBar x:Name="AudioLevelBar" Width="220" Height="16" Minimum="0" Maximum="1" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{StaticResource BgPanelLight}" Foreground="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderMist}"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>