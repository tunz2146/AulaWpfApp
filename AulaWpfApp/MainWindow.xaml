<Window x:Class="AulaWpfApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AULA 60 HE Control" Height="650" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Fill="#0B0F0D" Opacity="0.55" Grid.ColumnSpan="2"/>

        <!-- SIDEBAR -->
        <Border Background="{StaticResource BgPanel}" Grid.Column="0" BorderBrush="{StaticResource BorderMist}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="AULA 60 HE" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource TitleFont}" FontSize="22" FontWeight="Bold" Margin="20,25,20,25"/>

                    <Expander Header="Keyboard" Style="{StaticResource GothicExpander}">
                        <StackPanel>
                            <Button Content="Overview" Style="{StaticResource SubSidebarButton}" Tag="Keyboard" Click="Navigate_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Rapid Trigger" Style="{StaticResource GothicExpander}">
                        <StackPanel>
                            <Button Content="Travel" Style="{StaticResource SubSidebarButton}" Tag="RapidTrigger" Click="Navigate_Click"/>
                            <Button Content="Dead Band" Style="{StaticResource SubSidebarButton}" Tag="RapidTrigger" Click="Navigate_Click"/>
                            <Button Content="Switch" Style="{StaticResource SubSidebarButton}" Tag="RapidTrigger" Click="Navigate_Click"/>
                            <Button Content="Polling Rate" Style="{StaticResource SubSidebarButton}" Tag="RapidTrigger" Click="Navigate_Click"/>
                            <Button Content="Calibration" Style="{StaticResource SubSidebarButton}" Tag="RapidTrigger" Click="Navigate_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="SOCD" Style="{StaticResource GothicExpander}">
                        <StackPanel>
                            <Button Content="Overview" Style="{StaticResource SubSidebarButton}" Tag="Socd" Click="Navigate_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="RGB" Style="{StaticResource GothicExpander}">
                        <StackPanel>
                            <Button Content="Overview" Style="{StaticResource SubSidebarButton}" Tag="Rgb" Click="Navigate_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Profiles" Style="{StaticResource GothicExpander}">
                        <StackPanel>
                            <Button Content="Profile Default" Style="{StaticResource SubSidebarButton}" Tag="Profiles" Click="Navigate_Click"/>
                            <Button Content="Profile 1" Style="{StaticResource SubSidebarButton}" Tag="Profiles" Click="Navigate_Click"/>
                            <Button Content="Profile 2" Style="{StaticResource SubSidebarButton}" Tag="Profiles" Click="Navigate_Click"/>
                            <Button Content="Profile 3" Style="{StaticResource SubSidebarButton}" Tag="Profiles" Click="Navigate_Click"/>
                            <Button Content="Profile 4" Style="{StaticResource SubSidebarButton}" Tag="Profiles" Click="Navigate_Click"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="40">

            <!-- PAGE: KEYBOARD (nội dung hiện tại) -->
            <StackPanel x:Name="KeyboardPanel" Visibility="Visible">

                <TextBlock Text="AULA 60 HE" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>

                <TextBlock x:Name="ConnectionStatusText" Text="DISCONNECTED" Foreground="{StaticResource StatusBad}" FontSize="15" Margin="0,10,0,0"/>

                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderMist}" BorderThickness="1" Padding="25" Margin="0,25,0,20" CornerRadius="6">

                    <StackPanel>

                        <TextBlock Text="Keyboard Status" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource TitleFont}" FontSize="18"/>

                        <TextBlock Text="Device: AULA 60 HE" Foreground="{StaticResource TextSecondary}" Margin="0,15,0,5"/>

                        <TextBlock x:Name="DevicePathText" Text="Firmware: Chưa kết nối" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <Button Content="SCAN KEYBOARD" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Click="ScanKeyboard_Click"/>

                <Button Content="TEST RGB" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestRgb_Click"/>

                <Button Content="TEST CUSTOM COLOR" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestCustomColor_Click"/>

                <Button Content="TEST AUDIO" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestAudio_Click"/>

                <Button Content="TEST PER-KEY" Width="220" Height="46" HorizontalAlignment="Left" Style="{StaticResource GothicButton}" Margin="0,12,0,0" Click="TestPerKey_Click"/>


                <TextBlock x:Name="AudioLevelText" Text="Audio Level: 0.00" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,18,0,0"/>

                <ProgressBar x:Name="AudioLevelBar" Width="220" Height="16" Minimum="0" Maximum="1" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{StaticResource BgPanelLight}" Foreground="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderMist}"/>

            </StackPanel>

            <!-- PAGE: RAPID TRIGGER (placeholder, sẽ dựng chi tiết sau) -->
            <StackPanel x:Name="RapidTriggerPanel" Visibility="Collapsed">
                <TextBlock Text="Rapid Trigger" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Đang xây dựng giao diện chi tiết cho Rapid Trigger..." Foreground="{StaticResource TextSecondary}" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- PAGE: SOCD (placeholder) -->
            <StackPanel x:Name="SocdPanel" Visibility="Collapsed">
                <TextBlock Text="SOCD" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Đang xây dựng giao diện chi tiết cho SOCD..." Foreground="{StaticResource TextSecondary}" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- PAGE: RGB (placeholder) -->
            <StackPanel x:Name="RgbPanel" Visibility="Collapsed">
                <TextBlock Text="RGB" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Đang xây dựng giao diện chi tiết cho RGB..." Foreground="{StaticResource TextSecondary}" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- PAGE: PROFILES (placeholder) -->
            <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                <TextBlock Text="Profiles" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Đang xây dựng giao diện chi tiết cho Profiles..." Foreground="{StaticResource TextSecondary}" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>

        </Grid>

    </Grid>

</Window>